# Secret-free template; server does NOT load this file automatically.
# Inject these named values in the server process only. Never in Unity/Web builds.
COMMANDER_GATEWAY_ENABLED=false
COMMANDER_GATEWAY_PORT=8082
# Single-player companion authentication; no Rust/matchmaking service required.
COMMANDER_AUTH_MODE=standalone
COMMANDER_STANDALONE_SESSIONS_PATH=./private-state/service/sessions.json
# Legacy backend mode remains available only if deliberately selected in future.
# COMMANDER_AUTH_BASE_URL=http://127.0.0.1:8081
COMMANDER_GATEWAY_ORIGINS=https://game.example.invalid
COMMANDER_GATEWAY_OWNER_IDS=
COMMANDER_GATEWAY_LEDGER_PATH=./private-state/budget.json
COMMANDER_GATEWAY_MAX_AUDIO_SECONDS=600
COMMANDER_GATEWAY_MAX_PER_OWNER_AUDIO_SECONDS=600
COMMANDER_GATEWAY_MAX_SEMANTIC_REQUESTS=6
# REQUIRED: current verified conservative upper billing estimates incl minimums,
# maximum tokens, retries, taxes/margins. Empty means fail closed.
COMMANDER_GATEWAY_MAX_USD=
COMMANDER_AUDIO_USD_PER_SECOND=
COMMANDER_SEMANTIC_USD_PER_REQUEST=
COMMANDER_GATEWAY_POLICY_VERSION=
COMMANDER_GATEWAY_OPERATOR=
COMMANDER_UPSTREAM_RETENTION_DISCLOSURE=
COMMANDER_OPENAI_API_KEY=
COMMANDER_OPENROUTER_API_KEY=
