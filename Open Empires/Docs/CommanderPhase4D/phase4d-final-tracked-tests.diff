+        [Test]
+        public void LifecycleCommands_CannotBypassOwnership()
+        {
+            StrategicPlan plan = StartPlan();
+            var otherGoals = new CommanderGoalManager(simulation, 1);
+            var otherPlanner = new StrategicPlanner(otherGoals, _ => 5000);
