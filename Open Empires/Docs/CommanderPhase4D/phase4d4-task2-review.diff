+            Assert.That(chat.DisplayedTranscript, Does.Contain("Plan resumed."));
+            Assert.That(pipeline.DecisionHistory.History.Count, Is.EqualTo(decisions));
+            Assert.That(planner.Plans.Count, Is.EqualTo(1));
