+        internal bool CanResumeGoal(int goalId, int pausedTicks)
+        {
+            CommanderGoal goal = GetGoal(goalId);
+            if (pausedTicks < 0 || goal == null || goal.IsTerminal || !suspendedGoalIds.Contains(goalId))
