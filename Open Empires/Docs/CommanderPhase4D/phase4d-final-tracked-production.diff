+                    || CanShift(goal.LastEconomyCommandTick, pausedTicks))
+                && (goal.ObservedConstructionBuildingId < 0
+                    || CanShift(goal.LastConstructionProgressTick, pausedTicks))
+                && (goal.LastConstructionRecoveryTick == int.MinValue / 2
